<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sqlconn-analyze</AssemblyName>
    <RootNamespace>SqlConnectionAnalyzer.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sqlconn-analyze</ToolCommandName>
    <PackageId>SqlConnectionAnalyzer.Cli</PackageId>
    <Version>0.5.1</Version>
    <Description>Diagnoses Microsoft.Data.SqlClient connectivity failures stage by stage along the MS-TDS login flow, in the console or an interactive web UI.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required because the tool hosts the Blazor UI in-process for the serve command. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlConnectionAnalyzer.Core\SqlConnectionAnalyzer.Core.csproj" />
    <ProjectReference Include="..\SqlConnectionAnalyzer.Web\SqlConnectionAnalyzer.Web.csproj" />
  </ItemGroup>

</Project>
