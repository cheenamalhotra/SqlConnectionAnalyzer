<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SqlConnectionAnalyzer.Web</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Hosted in-process by the CLI serve command, so this project has no entry point. -->
    <OutputType>Library</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlConnectionAnalyzer.Core\SqlConnectionAnalyzer.Core.csproj" />
  </ItemGroup>

</Project>
